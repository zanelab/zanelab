# 构建上下文忽略（减小镜像体积、避免把本地依赖/产物打进层）
.git
.gitignore
.github
.idea
.vscode
.codebuddy
.trellis
node_modules
**/node_modules
# dist
# **/dist
coverage
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

