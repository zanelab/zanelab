# dev 环境差异项（其余配置见 public/config.js 运行时配置）
# 本文件由 `pnpm env:switch`（scripts/env-switch.mjs）在启动前写入，也可手工改；
# 但执行 `pnpm dev`（已串联 env:switch）时会按交互选择覆盖 VITE_PROXY_TARGET。
#
# VITE_PROXY_TARGET：dev 下 Vite 反代 /auth、/agent 的目标（后端真实地址）。
#   生产不读此项——由 nginx.conf 的 $api_upstream 反代。
#   临时覆盖示例：VITE_PROXY_TARGET=http://xxx pnpm dev
VITE_PROXY_TARGET=http://localhost:8080
