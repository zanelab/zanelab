# dev 环境差异项（其余配置见 public/config.js 运行时配置）

# VITE_USE_MOCK：dev-only 的 MSW 开关（true = 启动 MSW worker 拦截基座自身接口）。
#   只在 dev 有意义——生产构建（无 NODE_ENV 覆盖的 pnpm build）中 import.meta.env.DEV
#   为 false，该分支连同 worker 一起被消除，本项在生产不会被读取。
#   注意：接了真实后端却仍开着会由 mock 抢答，此时置 false。
VITE_USE_MOCK=false

# VITE_PROXY_TARGET：dev 下 Vite 反代 /iam/functions/v1 的目标（后端真实地址）；
#   留空时回落到 http://localhost:8081（iam 子应用 dev server）。
#   生产不读此项。
#   临时覆盖示例：VITE_PROXY_TARGET=http://xxx pnpm dev
VITE_PROXY_TARGET=
