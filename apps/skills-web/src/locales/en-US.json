      "faq": {
        "title": "Marketplace FAQ",
        "items": {
          "what": {
            "question": "What is the Agent Skills Marketplace?",
            "answer": "The marketplace offers ready-to-install SKILL.md packages for Claude Code, Codex, Cursor, Antigravity, and more. Every Skill ships with demo data and usage docs so you can understand its purpose and output before installing."
          },
          "free": {
            "question": "Are Skills free?",
            "answer": "Every output type has installable free Skills. Free and paid Skills are installed and run exactly the same way."
          },
          "install": {
            "question": "How do I install a Skill from the marketplace?",
            "answer": "Open a Skill and follow its usage docs to hand the Skill folder to your agent for installation, then start using it in your sessions."
          },
          "agents": {
            "question": "Which Coding Agents do these Skills support?",
            "answer": "Every Skill is a standard SKILL.md folder, so it runs directly in Claude Code, Codex, Cursor, Antigravity, and any agent that supports Agent Skills."
          },
          "contribute": {
            "question": "How do I add a new Skill to the marketplace?",
            "answer": "Submit your Skill through the \"Upload skills\" entry at the top of the page. Once approved, it will be listed for your colleagues."
          }
        }
      }
