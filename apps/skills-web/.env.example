# copy 本文件为 .env 并填写真实值（.env 不入库；shell 变量优先于 .env）。
# 本文件服务**独立 dev server**（pnpm dev:skills，:8084）；集成态下的代理目标与
# apikey 由宿主 portal-web 侧配置，见其 .env.example。

# VITE_USE_MOCK：dev-only 的 MSW 开关（true = 启动 worker 拦截 skills 域接口，
#   集成态与独立态各判一次，共用同名变量）。不填 = 关。
#   生产构建恒不启用（import.meta.env.DEV 守卫）。
VITE_USE_MOCK=false

# VITE_PROXY_TARGET：仅宿主 portal dev 生效——portal 反代 /skills/functions/v1
#   的目标（填 Supabase **基址**，如 https://<ref>.supabase.co；本应用独立 dev
#   server 不读此项）。留空 = portal 代理回落 http://localhost:8084（skills
#   dev server 的 MSW worker 接管）。临时覆盖见 portal .env.example。
VITE_PROXY_TARGET=

# VITE_API_KEY：Supabase publishable key（SUPABASE_PUBLISHABLE_KEY /
#   sb_publishable_… 或 legacy anon key）。设值后独立态请求由 http 拦截器自动
#   附加 apikey 头（云网关要求）；本地 supabase start 无鉴权可不填。
#   集成态的 apikey 来自宿主：portal 请求拦截器读 config.js 的 api.publishableKey
#   注入（本应用的 env 不参与集成态）。
VITE_API_KEY=

# VITE_ICON_PACK_URL：独立态图标包 URL（AppIcon 运行时注册表，iam 同名约定）。
#   本应用当前**不调用 initIcons**（消费的全部标识符在 @zanelab/ui 内置表，
#   BUILTIN_ICONS 收敛了 portal pack.json 全量），此变量保留为预留位：
#   独立态要接入远端图标包时，在 main.tsx 独立分支补 initIcons({ iconPackUrl })
#   即可（iam main.tsx 同款；缺省 '/icons/pack.json' 部署在宿主 public）。
VITE_ICON_PACK_URL=

