# iam 子应用 — 环境变量（仅影响独立 dev server）

# 独立态 mock 开关（true = 启动 MSW worker 拦截 OTP 请求）
VITE_IAM_USE_MOCK=false

# 集成态（宿主 dev server）转发 /iam/functions/v1 的目标见 portal-web 侧：
# apps/portal-web/.env.development 的 VITE_PROXY_TARGET（留空 → 回落到
# http://localhost:8081，即本应用 dev server）。本机临时覆盖用 shell 变量：
# `VITE_PROXY_TARGET=http://xxx pnpm dev`（宿主 vite.config.ts 中 process.env 优先于 .env 文件）