# copy 本文件为 .env 并填写真实值（.env 不入库；shell 变量优先于 .env）。
# 本文件服务**独立 dev server**（pnpm dev:iam，:8081）；集成态下的代理目标与
# apikey 由宿主 portal-web 侧配置，见其 .env.example。

# VITE_USE_MOCK：dev-only 的 MSW 开关（true = 启动 worker 拦截 OTP 接口，
#   集成态与独立态各判一次，共用同名变量）。不填 = 关。
#   生产构建恒不启用（import.meta.env.DEV 守卫）。
VITE_USE_MOCK=false

# VITE_PROXY_TARGET：仅 dev 生效——本 dev server 反代 /functions/v1 的目标
#   （填 Supabase **基址**，如 https://<ref>.supabase.co；不含 /functions/v1，
#   路径原样转发）。留空 = 不代理：此时独立态只能靠 VITE_USE_MOCK=true 的
#   worker 拦截，关掉 mock 会对 /functions/v1/* 直接 404。
#   临时覆盖：VITE_PROXY_TARGET=https://<ref>.supabase.co pnpm dev:iam
VITE_PROXY_TARGET=

# VITE_API_KEY：Supabase publishable key（SUPABASE_PUBLISHABLE_KEY /
#   sb_publishable_… 或 legacy anon key）。设值后独立态请求由 http 拦截器自动
#   附加 apikey 头（云网关要求）；本地 supabase start 无鉴权可不填。
#   集成态由宿主 portal-web 的 dev proxy 注入。
VITE_API_KEY=
